# 完整配置可由 Web 控制台自动生成与维护（推荐）：
#   1. 直接运行 python3 bot.py
#   2. 浏览器打开 http://127.0.0.1:8000 按提示初始化密码并填写配置
# 以下为手动参考模板。
bot:
  token: 1234:1234567890abcdef
  admin_id:
    - 0
    - 0
  # 可选：访问 Telegram API 使用的代理，例如 http://127.0.0.1:7890
  proxy:
crisp:
  id:
  key:
  website:
  msgapi: rtm          # rtm = WebSocket 实时推送；rest = 定时轮询
  poll_interval: 60    # msgapi 为 rest 时的轮询间隔（秒）
welcome:
  enabled: true
  ttl_hours: 24
  message: "你好，欢迎联系客服，下面是常用查询命令：\n1. 教程\n2. 官网\n3. 苹果id\n4. 苹果id无法更新\n5. 无网络\n\n请直接回复对应数字或关键词获取帮助。"
autoreply:
  - pattern: "1|教程"
    reply: "请查阅官网使用教程"
  - pattern: "2|官网"
    reply: "官网地址为：https://example.com"
  - pattern: "3|苹果id"
    field: "VIP"
    op: ">"
    value: "0"
    reply: "这是私有苹果id: https://aunlock.laomaos.com/share/HzUFBCWShs 密码wukong"
  - pattern: "3|苹果id"
    field: "VIP"
    op: "=="
    value: "0"
    reply: "请稍等，私有苹果 ID 需要人工核验后下发~"
# console 段由程序自动维护（控制台密码哈希、session 密钥），请勿手动编辑
